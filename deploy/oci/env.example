APP_NAME="Nur Food POS API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.example
APP_TIMEZONE=Asia/Dhaka
TLS_EMAIL=ops@your-domain.example
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nur_food_pos
DB_USERNAME=nur_food_pos
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

FRONTEND_ORIGINS=https://food-software-sigma.vercel.app
SANCTUM_STATEFUL_DOMAINS=food-software-sigma.vercel.app
SANCTUM_EXPIRATION=480
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
