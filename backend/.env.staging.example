APP_NAME="Nur Food POS API"
APP_ENV=staging
APP_KEY=base64:GENERATE_A_UNIQUE_KEY_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://REPLACE_WITH_STAGING_API_HOST
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_STAGING_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_STAGING_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_STAGING_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SANCTUM_STATEFUL_DOMAINS=REPLACE_WITH_STAGING_FRONTEND_HOST
SANCTUM_EXPIRATION=480
FRONTEND_ORIGINS=https://REPLACE_WITH_STAGING_FRONTEND_HOST
