FROM php:8.3-apache-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates unzip libicu-dev libzip-dev libonig-dev libpng-dev libjpeg62-turbo-dev \
        libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" bcmath gd intl mbstring opcache pdo_mysql zip \
    && a2enmod headers rewrite \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY backend/docker/opcache-production.ini /usr/local/etc/php/conf.d/99-opcache-production.ini
WORKDIR /var/www/html
COPY backend/ ./
COPY backend/docker/captain-vhost.conf /etc/apache2/sites-available/000-default.conf
COPY backend/docker/captain-entrypoint.sh /usr/local/bin/captain-entrypoint
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod +x /usr/local/bin/captain-entrypoint

ENV PORT=80
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/captain-entrypoint"]
