# Dependencies
node_modules/
dist/
.env
.env.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Temporary scratch migration scripts
update_*.js
polish_*.js
refine_*.js
fix_verify.js
inspect.js
sync_to_app.js
scratch/

test_result_*.png

# Laravel Backend Exclusions
backend/vendor/
backend/.env
backend/storage/*.key
backend/database/*.sqlite
backend/database/*.sqlite-journal
backend/node_modules/
backend/public/storage
backend/public/hot

# Frontend build and local-only files
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
frontend/tools/archive/
!frontend/tools/archive/
frontend/tools/archive/*
!frontend/tools/archive/scratch/
frontend/tools/archive/scratch/*
!frontend/tools/archive/scratch/eslint_test/
!frontend/tools/archive/scratch/eslint_test/package.json
!frontend/tools/archive/scratch/eslint_test/package-lock.json
