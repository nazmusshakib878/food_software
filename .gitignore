!frontend/tools/archive/scratch/fix_pos.js
!frontend/tools/archive/scratch/fix_syntax.js
!frontend/tools/archive/scratch/fix_syntax2.js
!frontend/tools/archive/scratch/fix_syntax3.js

# Vite cache
.vite/
frontend/.vite/
frontend/vite.stdout.log
frontend/vite.stderr.log
